<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <form action="get-from-data" method="post">
        <input type="text"
         placeholder="Enter your name" 
         style="padding: 10px; font-size: 16px; border: 2px solid #0571be; border-radius: 5px;" name="username"  />
         
         <input type="password"
         placeholder="Enter your password"
         style="padding: 10px; font-size: 16px; border: 2px solid #0895b1; border-radius: 5px;" name="password"/>
            
         <input type="email"
         placeholder="Enter your email"
         style="padding: 10px; font-size: 16px; border: 2px solid #0889da; border-radius: 5px;"  name="email" />
           
         <button type="submit"
            style="padding: 10px 20px; font-size: 16px; background-color: #28a745; color: white; border: none; border-radius: 5px;">Submit</button>
    </form>
</body>
</html>